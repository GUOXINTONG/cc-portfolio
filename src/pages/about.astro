---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'About';
const description = 'Learn more about Terry Guo, a Large Language Model Algorithm Engineer specializing in AI-powered applications.';

const skills = [
  { category: 'AI/ML', items: ['Large Language Models', 'RAG Systems', 'Code Generation', 'Machine Learning Engineering'] },
  { category: 'Languages', items: ['Python', 'TypeScript', 'JavaScript'] },
  { category: 'Frameworks & Tools', items: ['Astro', 'Tailwind CSS', 'React', 'Next.js', 'FastAPI'] },
  { category: 'MLOps', items: ['Docker', 'Kubernetes', 'CI/CD', 'Model Serving'] },
];

const experience = [
  {
    role: 'AI Engineer',
    company: 'HKRC',
    period: 'Current',
    description: 'Working on Large Language Model applications and AI-powered solutions.',
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-24">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">About Me</h1>

    <div class="mt-8 space-y-6 text-lg text-secondary leading-relaxed">
      <p>
        Hi, I'm Terry Guo, a Large Language Model Algorithm Engineer based in Hong Kong.
        I'm passionate about building AI-powered applications that solve real-world problems.
      </p>

      <p>
        My work focuses on leveraging the power of Large Language Models for code generation,
        knowledge retrieval, and intelligent automation. I enjoy exploring the intersection of
        cutting-edge AI research and practical engineering solutions.
      </p>

      <p>
        When I'm not working on AI projects, I enjoy contributing to open-source, writing
        technical blog posts, and continuously learning about new developments in the field.
      </p>
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">Skills</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {skills.map((skillGroup) => (
          <div class="rounded-lg border border-border p-4">
            <h3 class="font-medium text-foreground">{skillGroup.category}</h3>
            <ul class="mt-2 space-y-1">
              {skillGroup.items.map((item) => (
                <li class="text-sm text-secondary">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">Experience</h2>
      <div class="mt-6 space-y-8">
        {experience.map((job) => (
          <div class="border-l-2 border-border pl-4">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <h3 class="font-medium text-foreground">{job.role}</h3>
              <span class="text-secondary">·</span>
              <span class="text-secondary">{job.company}</span>
            </div>
            <p class="mt-1 text-sm text-secondary">{job.period}</p>
            <p class="mt-2 text-secondary">{job.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">Contact</h2>
      <p class="mt-4 text-secondary">
        I'm always open to discussing new opportunities, interesting projects, or just having a chat about AI and technology.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href="mailto:terryguo0616@gmail.com"
          class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary/90"
        >
          Email Me
        </a>
        <a
          href="https://github.com/GUOXINTONG"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-muted"
        >
          GitHub
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
